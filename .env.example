# ============================================================
# Mark-XXXIX-OR / K1NG-Makro / Makro-smart
# Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real API keys.
# NEVER commit .env or config/api_keys.json to git!

# --- LLM Providers ---
OLLAMA_API_KEY=your_ollama_api_key_here
BIGMODEL_API_KEY=your_bigmodel_api_key_here

# --- Web Search ---
SERPAPI_KEY=your_serpapi_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# --- K1NG Server ---
GODBRAIN_API_KEY=generate_a_strong_random_key_here

# --- Optional: cTrader / Trading ---
CTRADER_ACCOUNT_ID=your_ctrader_account_id
CTRADER_API_KEY=your_ctrader_api_key

# --- Optional: Notifications ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# --- Optional: Data Sources ---
ALPHA_VANTAGE_KEY=your_alpha_vantage_key
OPENROUTER_KEY=your_openrouter_key

# ============================================================
# Security Notes:
# - Use strong random strings for GODBRAIN_API_KEY (min 32 chars)
# - Rotate keys every 90 days
# - Never share .env files
# ============================================================